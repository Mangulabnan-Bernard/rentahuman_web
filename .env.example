# Copy this file to .env.local and fill in real values.
# Never commit your actual .env / .env.local — only this template is tracked.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign session cookies (HMAC-SHA256). REQUIRED in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database (Prisma + MySQL) — see prisma/schema.prisma
# ---------------------------------------------------------------------------
# Example: mysql://user:password@localhost:3306/rentahuman
DATABASE_URL=

# ---------------------------------------------------------------------------
# OAuth providers (optional — for social sign-in). Buttons only appear when a
# provider's ID + secret are both set. Register these callback URLs with the
# provider (must match NEXT_PUBLIC_APP_URL below):
#   GitHub  -> {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
#   Google  -> {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# ---------------------------------------------------------------------------
# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App
GITHUB_ID=
GITHUB_SECRET=

# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app (used for callbacks / absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
