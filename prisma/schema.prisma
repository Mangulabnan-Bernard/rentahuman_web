// Prisma schema for RentHuman (MySQL).
//
// Setup:
//   1. Set DATABASE_URL in .env.local (see .env.example)
//   2. npx prisma generate
//   3. npx prisma migrate dev --name init
//   4. npx prisma db seed         (creates the demo accounts)
//
// The running app uses Prisma when DATABASE_URL is set and falls back to an
// in-memory store otherwise (see app/lib/users.ts), so the demo works with or
// without a database.
//
// Enum values are lowercase and ids are Int to match the application's existing
// types (app/utils/auth.ts), so no mapping layer is required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (migrations use
  // DIRECT_URL) and are supplied to PrismaClient via the pg driver adapter.
}

enum Role {
  client
  agent
  admin
}

enum VerificationStatus {
  unverified
  pending
  verified
}

enum TaskStatus {
  open
  in_progress
  completed
  disputed
}

enum Urgency {
  low
  medium
  high
}

enum EarningStatus {
  pending
  claimable
  paid_out
}

model User {
  id                 Int                @id @default(autoincrement())
  name               String?
  email              String             @unique
  emailVerified      DateTime?
  passwordHash       String? // null for OAuth-only accounts
  image              String?
  role               Role               @default(client)
  verificationStatus VerificationStatus @default(unverified)
  profileCompleted   Boolean            @default(false)
  bio                String?            @db.Text
  title              String?
  hourlyRate         Int?
  location           String?
  skills             Json? // string[] stored as JSON for portability
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accounts      Account[]
  sessions      Session[]
  postedTasks   Task[]    @relation("PostedTasks")
  assignedTasks Task[]    @relation("AssignedTasks")
  earnings      Earning[]

  @@index([role])
}

model Task {
  id              Int        @id @default(autoincrement())
  title           String
  description     String     @db.Text
  category        String
  budget          Decimal    @db.Decimal(10, 2)
  deadline        DateTime?
  location        String?    @default("Remote")
  status          TaskStatus @default(open)
  urgency         Urgency    @default(medium)
  skills          Json?
  progress        Int        @default(0)
  applicants      Int        @default(0)
  postedById      Int
  postedBy        User       @relation("PostedTasks", fields: [postedById], references: [id])
  assignedAgentId Int?
  assignedAgent   User?      @relation("AssignedTasks", fields: [assignedAgentId], references: [id])
  earnings        Earning[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([postedById])
  @@index([assignedAgentId])
}

model Earning {
  id          Int           @id @default(autoincrement())
  taskId      Int?
  task        Task?         @relation(fields: [taskId], references: [id])
  agentId     Int
  agent       User          @relation(fields: [agentId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  status      EarningStatus @default(pending)
  description String?       @db.Text
  date        DateTime      @default(now())
  payoutDate  DateTime?

  @@index([agentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// NextAuth (Auth.js) adapter models — used with @auth/prisma-adapter when
// OAuth/social sign-in is enabled (GITHUB_*, GOOGLE_* in .env.example).
// ---------------------------------------------------------------------------

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
